/* 全局样式 */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  height: 100%;
  overflow-x: hidden;
}

/* 常用样式类 */
.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #5E72E4 100%);
  border-radius: 4rpx;
}

/* 短语卡片样式 */
.phrase-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 4rpx solid transparent;
}

.phrase-card:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #4A90E2 0%, #5E72E4 100%);
  color: #fff;
}

.phrase-text {
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

/* 场景分类样式 */
.scene-category {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.category-header {
  padding: 32rpx;
  background: linear-gradient(90deg, #f8f9fa 0%, #eef2f7 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-arrow {
  transition: transform 0.3s ease;
  color: #666;
  font-size: 24rpx;
}

.category-arrow.expanded {
  transform: rotate(180deg);
}

.category-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.category-content.expanded {
  max-height: 1000rpx;
}

.category-phrases {
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.category-phrase {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.category-phrase:active {
  background: #e3f2fd;
  border-color: #4A90E2;
}

/* 按钮样式 */
.btn {
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #5E72E4 100%);
  color: #fff;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 表单样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #ddd;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #4A90E2;
}

.form-textarea {
  min-height: 200rpx;
  resize: vertical;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}

.empty-state text {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 16rpx;
}

/* 提示消息 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 32rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  z-index: 9999;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.toast.show {
  opacity: 1;
}

/* 导航栏按钮 */
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.nav-btn:active {
  background: rgba(255, 255, 255, 0.3);
}
